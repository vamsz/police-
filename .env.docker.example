# ---- docker compose environment ----
# Copy to .env (in this repo root) and fill in. Compose reads it automatically.
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Database (the compose Postgres service uses these)
POSTGRES_USER=rally
POSTGRES_PASSWORD=
POSTGRES_DB=police_rally

# App secrets — all required, no placeholders accepted at boot
JWT_SECRET=
ADMIN_REGISTRATION_CODE=
OFFICER_REGISTRATION_CODE=

# Google Maps (optional; blank shows a setup notice instead of a map)
GOOGLE_MAPS_API_KEY=

# Comma-separated extra origins allowed to call the API cross-origin (usually blank)
CORS_ORIGINS=

# Host port to publish the app on
APP_PORT=4000

# Default map view (your deployment city)
MAP_DEFAULT_LAT=12.9716
MAP_DEFAULT_LNG=77.5946
