# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/police_rally

# ---- Authentication ----
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8

# Registration is closed to the public: a new account must present one of these
# shared codes. Rotate them whenever someone leaves the unit.
ADMIN_REGISTRATION_CODE=
OFFICER_REGISTRATION_CODE=

# ---- Maps ----
# Google Cloud Console -> enable "Maps JavaScript API" -> create key ->
# restrict it to your domain. Leaving this blank shows a setup notice instead
# of a map; everything else still works.
GOOGLE_MAPS_API_KEY=

# Map view. The default center is shown before any officer position is known;
# set it to your deployment city. MAP_MIN_ZOOM is how far OUT the map can go
# (low = can zoom right out to a regional view; raise toward 11 to keep it at
# city level). MAP_MAX_ZOOM is how far in.
MAP_DEFAULT_LAT=12.9716
MAP_DEFAULT_LNG=77.5946
MAP_DEFAULT_ZOOM=12
MAP_MIN_ZOOM=3
MAP_MAX_ZOOM=20

# ---- Tracking behaviour ----
# How often an officer's browser reports its position.
REPORT_INTERVAL_SECONDS=10
# A fix vaguer than this is recorded but never used to judge a breach.
MAX_USABLE_ACCURACY_METERS=100
# GPS error forgiven before calling a breach, so a stationary officer does not
# alert just because the fix wandered.
ACCURACY_GRACE_CAP_METERS=35
# Faster than any plausible patrol movement between two fixes (~250 km/h).
IMPLAUSIBLE_SPEED_MPS=70
# A run of byte-identical fixes this long suggests an injected position.
IDENTICAL_FIX_THRESHOLD=5
# Radius the console pre-fills when posting an officer.
DEFAULT_RADIUS_METERS=75
# An assigned officer silent this long raises a signal_lost alert.
SIGNAL_LOST_AFTER_SECONDS=180
MONITOR_INTERVAL_SECONDS=30
FIX_RETENTION_DAYS=30

# ---- Console ----
ADMIN_POLL_SECONDS=5

# ---- Optional ----
# Comma-separated origins allowed to call the API cross-origin. Leave blank when
# the UI is served from this same server, which is the default.
CORS_ORIGINS=
